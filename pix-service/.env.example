# pix-service — environment variables for local development
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql+asyncpg://pix:pix_secret@localhost:5433/pix_service

# Provider: sandbox | corpx
PIX_PROVIDER=sandbox

# CorpX (preencher para testar com sandbox real da CorpX)
CORPX_ENV=sandbox
CORPX_API_BASE_URL=https://api.dev.corpxapi.com
CORPX_AUTH_BASE_URL=https://auth.dev.corpxapi.com
CORPX_CLIENT_ID=
CORPX_CLIENT_SECRET=
CORPX_SCOPE=
CORPX_TENANT_ID=
CORPX_ACCOUNT_ID=
CORPX_RECEIVER_PIX_KEY=
CORPX_WEBHOOK_SECRET=

# CredBridge (API NestJS)
CREDBRIDGE_API_URL=http://localhost:3001
CREDBRIDGE_PIX_WEBHOOK_PATH=/v1/pix/webhooks/orders
CREDBRIDGE_PIX_WEBHOOK_SECRET=dev_webhook_secret_change_in_production
CREDBRIDGE_PIX_SERVICE_API_KEY=dev_api_key_change_in_production

# Comportamento
DEFAULT_QR_EXPIRATION_SECONDS=1800
CALLBACK_MAX_ATTEMPTS=5
CALLBACK_BASE_DELAY_SECONDS=30
