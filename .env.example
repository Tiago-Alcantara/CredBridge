# Database
# Match docker-compose.yml defaults (POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB)
DATABASE_URL=postgresql://credbridge:credbridge@localhost:5432/credbridge

# Optional overrides for docker-compose (defaults match above)
# POSTGRES_USER=credbridge
# POSTGRES_PASSWORD=credbridge
# POSTGRES_DB=credbridge
# POSTGRES_PORT=5432

# Stellar / Soroban
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_SECRET_KEY=
STELLAR_CONTRACT_ID=
STELLAR_WALLET_SECRET=

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
WEB_URL=http://localhost:3000

# Google OAuth (same Client ID for both — no client secret in browser)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Privy
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: avoids a Privy key lookup during backend token verification.
PRIVY_JWT_VERIFICATION_KEY=
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# API
PORT=3001

# Pix Microservice (CredBridge → Python Pix Service)
PIX_SERVICE_BASE_URL=http://localhost:8001
PIX_SERVICE_API_KEY=dev_api_key_change_in_production

# Pix Webhook (Python Pix Service → CredBridge)
PIX_WEBHOOK_SECRET=dev_webhook_secret_change_in_production
PIX_WEBHOOK_MAX_SKEW_SECONDS=300
PIX_DEPOSIT_EXPIRATION_SECONDS=1800
