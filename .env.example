# Database
# Match docker-compose.yml defaults (POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB)
DATABASE_URL=postgresql://credbridge:credbridge@localhost:5432/credbridge

# Optional overrides for docker-compose (defaults match above)
# POSTGRES_USER=credbridge
# POSTGRES_PASSWORD=credbridge
# POSTGRES_DB=credbridge
# POSTGRES_PORT=5432

# Stellar
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SECRET_KEY=

# Etherfuse Anchor (BRL on/off-ramp via PIX — sandbox only for Brazil)
# Get API key at https://dashboard.etherfuse.com
ETHERFUSE_API_KEY=
ETHERFUSE_BASE_URL=https://api.sand.etherfuse.com



# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Google OAuth (same Client ID for both — no client secret in browser)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# API
PORT=3001

# Financial authorization (WebAuthn)
WEB_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost

# Frontend — Stellar / Passkey
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_WALLET_WASM_HASH=
