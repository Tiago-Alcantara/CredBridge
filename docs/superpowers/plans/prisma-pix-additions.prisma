// Prisma schema extension — adds Pix fields to Transaction
// and new models for PixWebhookEvent and ReceivableCollection

// ─────────────────────────────────────────── //
// NOTE: paste these fields and models into     //
// apps/api/prisma/schema.prisma                //
// ─────────────────────────────────────────── //

// Extend Transaction model with these fields:
//
//   pixOrderId        String?   @unique
//   pixIdentifier     String?   @unique
//   pixTxid           String?
//   pixPaymentId      String?
//   pixTransactionId  String?
//   pixEndToEndId     String?
//   pixQrCodePayload  String?
//   pixQrCodeLocation String?
//   pixExpiresAt      DateTime?
//   pixConfirmedAt    DateTime?
//   pixFailureReason  String?
//   pixMetadata       Json?

// New models to add:

model PixWebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  pixOrderId  String
  externalId  String
  identifier  String?
  type        String
  status      String
  amount      Float
  payload     Json
  processedAt DateTime @default(now())

  @@index([pixOrderId])
  @@index([externalId])
  @@index([identifier])
}

model ReceivableCollection {
  id           String    @id @default(uuid())
  receivableId String
  pixOrderId   String?   @unique
  identifier   String?   @unique
  amount       Float
  dueDate      DateTime
  status       String    @default("pending_payment")
  txHash       String?
  endToEndId   String?
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([receivableId])
}
