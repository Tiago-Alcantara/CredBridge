      "x": 116, "y": 892,
      "width": 608, "height": 86,
      "text": "{\n  key:         receivable.id,           // NF-e unique key\n  value:       receivable.value,        // valor em R$\n  dueDate:     receivable.dueDate,      // data vencimento\n  xmlHash:     receivable.documentHash, // SHA-256 do XML\n  ownerUserId: receivable.userId        // id do proprietário\n}",
