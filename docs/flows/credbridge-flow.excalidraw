    {
      "type": "text", "id": "p1_ev_wasm",
      "x": 35, "y": 276, "width": 680, "height": 18,
      "text": "walletWasmHash = \"abc123...def456\"   ← bytecode do contrato smart wallet, uploadado UMA vez, mesmo para todos os usuários",
      "originalText": "walletWasmHash = \"abc123...def456\"   ← bytecode do contrato smart wallet, uploadado UMA vez, mesmo para todos os usuários",
