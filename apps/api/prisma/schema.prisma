generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Receivable {
  id             String   @id @default(uuid())
  userId         String
  value          Float
  type           String
  status         String   @default("pending")
  debtorName     String
  debtorDocument String
  documentHash   String?
  txHash         String?
  paymentTxHash  String?
  dueDate        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User       @relation("UserReceivables", fields: [userId], references: [id])
  documents      Document[]
  settlements    Settlement[]
  investment     Investment?
}

model Document {
  id           String     @id @default(uuid())
  receivableId String
  url          String
  hash         String
  type         String
  createdAt    DateTime   @default(now())

  receivable   Receivable @relation(fields: [receivableId], references: [id])
}

model Settlement {
  id             String     @id @default(uuid())
  receivableId   String
  amount         Float
  method         String
  status         String     @default("pending")
  txHash         String?
  stellarTxHash  String?
  settledAt      DateTime?
  createdAt      DateTime   @default(now())

  receivable     Receivable @relation(fields: [receivableId], references: [id])
}

model User {
  id                    String   @id @default(uuid())
  email                 String   @unique
  passwordHash          String?
  googleId              String?  @unique
  provider              String   @default("email")
  role                  String?
  name                  String?
  stellarWalletId       String?
  passkeyId             String?
  passkeyPublicKey      String?
  walletType            String?
  walletStatus          String?
  privyUserId           String?  @unique
  privyStellarWalletAddress String? @unique
  privyWalletStatus     String?
  phone                 String?
  address               String?
  companyName           String?
  cnpj                  String?  @unique
  monthlyRevenue        Float?
  sector                String?
  investorType          String?
  riskProfile           String?
  operationalLimit      Float?
  etherfuseCustomerId   String?
  etherfuseBankAccountId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  receivables           Receivable[] @relation("UserReceivables")
  investments           Investment[] @relation("UserInvestments")
  auditLogs             AuditLog[]   @relation("UserAuditLogs")
  financialAuthorizations FinancialAuthorization[] @relation("UserFinancialAuthorizations")
  transactions          Transaction[] @relation("UserTransactions")
}

model FinancialAuthorization {
  id           String    @id @default(uuid())
  userId       String
  walletId     String
  operation    String
  resourceId   String?
  amount       String?
  destination  String?
  nonce        String    @unique
  payloadHash  String    @unique
  payload      Json
  signature    Json?
  expiresAt    DateTime
  verifiedAt   DateTime?
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  user         User      @relation("UserFinancialAuthorizations", fields: [userId], references: [id])

  @@index([userId, operation])
  @@index([expiresAt])
}

model AuditLog {
  id           String   @id @default(uuid())
  event        String
  entityId     String
  entityType   String
  userId       String
  txHash       String?
  metadata     Json?
  createdAt    DateTime @default(now())

  user         User     @relation("UserAuditLogs", fields: [userId], references: [id])

  @@index([entityId, entityType])
  @@index([userId])
}

model Investment {
  id                 String     @id @default(uuid())
  investorUserId     String
  receivableId       String     @unique
  amountPaid         Float
  faceValue          Float
  discountRate       Float      @default(0.03)
  status             String     @default("active")
  pixTxId            String?
  paymentTxHash      String?
  nftTransferTxHash  String?
  paidAt             DateTime   @default(now())
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  receivable     Receivable @relation(fields: [receivableId], references: [id])
  investor       User       @relation("UserInvestments", fields: [investorUserId], references: [id])

  @@index([investorUserId])
}

model Transaction {
  id                 String    @id @default(uuid())
  userId             String
  type               String    // "DEPOSIT" (Aporte PIX) ou "WITHDRAWAL" (Resgate PIX)
  amount             Float
  status             String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "PENDING_PAYMENT", "COMPLETED"
  pixKey             String?   // Necessário para resgates
  txHash             String?   // Hash da transação Stellar correspondente (Mint/Burn)
  approvedBy         String?   // ID do operador que aprovou

  // Campos Pix — adicionados na integração CorpX
  pixOrderId         String?   @unique  // ID da ordem no microserviço Pix
  pixIdentifier      String?   @unique  // Identifier curto (NanoID) para reconciliação CorpX
  pixTxid            String?            // txid CorpX do QR Code
  pixPaymentId       String?            // paymentId CorpX do Pix Out
  pixTransactionId   String?            // transactionId CorpX
  pixEndToEndId      String?            // End-to-end ID Banco Central
  pixQrCodePayload   String?            // EMV copia-e-cola
  pixQrCodeLocation  String?            // URL da imagem do QR
  pixQrCodeBase64    String?   @db.Text // QR code em base64 gerado localmente
  pixExpiresAt       DateTime?          // Expiração do QR
  pixConfirmedAt     DateTime?          // Confirmação do pagamento Pix
  pixFailureReason   String?            // Motivo da falha, se houver
  pixMetadata        Json?              // Metadados adicionais do Pix

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation("UserTransactions", fields: [userId], references: [id])

  @@index([pixIdentifier])
  @@index([pixOrderId])
}

// Evento de webhook Pix recebido pelo módulo NestJS — usado para idempotência
model PixWebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  pixOrderId  String
  externalId  String
  identifier  String?
  type        String
  status      String
  amount      Float
  payload     Json
  processedAt DateTime @default(now())

  @@index([pixOrderId])
  @@index([externalId])
  @@index([identifier])
}

// Cobrança futura ao sacado de uma NF-e antecipada
model ReceivableCollection {
  id                String    @id @default(uuid())
  receivableId      String
  pixOrderId        String?   @unique
  identifier        String?   @unique
  amount            Float
  dueDate           DateTime
  status            String    @default("pending_payment")
  txHash            String?
  endToEndId        String?
  pixQrCodePayload  String?
  pixQrCodeLocation String?
  pixQrCodeBase64   String?   @db.Text
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([receivableId])
}
